# 複製此檔為 .env 並填入你的 DeepSeek API Key
# （不要把 .env 提交到 GitHub）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模擬裝置（沒有 Arduino 也能讓網站跑起來）—— 不填就用預設值
SIM_AUTOSTART=1          # 開伺服器時自動啟動模擬裝置（0 = 關閉）
SIM_INTERVAL=5           # 每幾秒產生一筆模擬資料
SIM_DEEPSEEK_EVERY=0     # 每 N 筆做一次完整 AI 分析；0 = 串流完全不呼叫 API（零成本）
SIM_NOISE_SCALE=1.0      # 雜訊尺度；1.0 = 與訓練資料相同的散佈程度
SIM_DRIFT=0.12           # 情緒變化快慢：0.12 約每分鐘換一次，0.40 約每 20 秒換一次

# Excel 批量預測：每一列都做完整分析（ML + DeepSeek 投票 + 解釋），與即時接收相同
# 每列會打 2 次 API；EXCEL_AI_WORKERS 控制同時打幾條（1–8，預設 4）
EXCEL_AI_WORKERS=4       # 實測每列約 5.7 秒，並行 4 條約快 3 倍

# 真實裝置（有線）：改成你的 COM 口，例如 COM3
# SERIAL_PORT=COM3
# SERIAL_BAUD=115200
